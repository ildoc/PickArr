{
  "Urls": "http://+:8080",
  "Pickarr": {
    "DataPath": "/config"
  },
  "Hangfire": {
    "Storage": "Sqlite",
    "SqliteFileName": "jobs.db",
    "DashboardEnabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
