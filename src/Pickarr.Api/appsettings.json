{
  "Urls": "http://+:8080",
  "Pickarr": {
    "DataPath": "/config"
  },
  "Hangfire": {
    "Storage": "Sqlite",
    "SqliteFileName": "jobs.db",
    "DashboardEnabled": false
  },
  "LOG_LEVEL": "Debug",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
